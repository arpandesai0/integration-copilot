GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=your-supported-gemini-model
# Optional faster structured synthesis model; defaults to GEMINI_MODEL.
GEMINI_SYNTHESIS_MODEL=
# Optional fast model for focused grounded searches; defaults to GEMINI_MODEL.
GEMINI_RESEARCH_MODEL=
DATABASE_URL=sqlite:///./integration_copilot.db
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
GUIDE_FRESHNESS_DAYS=30
RESEARCH_TIMEOUT_SECONDS=240
RESEARCH_SEARCH_TIMEOUT_SECONDS=150
RESEARCH_SYNTHESIS_TIMEOUT_SECONDS=75
RESEARCH_EXCERPT_TIMEOUT_SECONDS=4
GEMINI_RESEARCH_THINKING_LEVEL=low
CHAT_TIMEOUT_SECONDS=180
CLARIFICATION_INTENT_TIMEOUT_SECONDS=60
CLARIFICATION_REPLY_TIMEOUT_SECONDS=90
GEMINI_CHAT_MODEL=
